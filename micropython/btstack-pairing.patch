+#ifdef WATTWIND_BT_TRACE
+// Packet trace on the USB serial (build with TRACE=1), as in the C cycling simulator.
+// SMP: 01 PairReq, 02 PairRsp, 03 Confirm, 04 Random, 05 PairFailed (+reason), 06-0a keys, 0b SecurityReq.
+// ATT: 01 error (req, handle, code), 04/05 find info, 08/09 read by type, 0a/0b read, 10/11 by group, 12/13 write, 1b notify.
+// HCI: LE meta 01 connected, 03 conn update, 05 LTK request; cmd 201a LTK reply, 201b LTK negative reply.
+static void wattwind_trace_reset(void) {
+}
+
+static void wattwind_trace_log_message(int log_level, const char *format, va_list argptr) {
+    (void)log_level;
+    (void)format;
+    (void)argptr;
+}
+
+static void wattwind_trace_log_packet(uint8_t packet_type, uint8_t in, uint8_t *packet, uint16_t len) {
+    const char *dir = in ? "RX" : "TX";
+    unsigned t = (unsigned)mp_hal_ticks_ms();
+    switch (packet_type) {
+        case HCI_COMMAND_DATA_PACKET: {
+            uint16_t op = little_endian_read_16(packet, 0);
+            if (op == 0x2017 || op == 0x2018) {
+                break;  // LE Encrypt / LE Rand: crypto steps, too noisy
+            }
+            mp_printf(&mp_plat_print, "%u HCI %s cmd 0x%04x\n", t, dir, op);
+            break;
+        }
+        case HCI_EVENT_PACKET:
+            if (packet[0] == 0x0f && len >= 6) {
+                // Command Status: only failures, or connection attempts (LE Create Connection 0x200d / ext 0x2043)
+                uint16_t op = little_endian_read_16(packet, 4);
+                if (packet[2] != 0 || op == 0x200d || op == 0x2043) {
+                    mp_printf(&mp_plat_print, "%u HCI %s CMD STATUS 0x%02x for cmd 0x%04x\n", t, dir, packet[2], op);
+                }
+                break;
+            }
+            if (packet[0] == 0x0e && len >= 6 && packet[5] != 0) {
+                // Command Complete with an error (status = first return parameter)
+                mp_printf(&mp_plat_print, "%u HCI %s CMD COMPLETE error 0x%02x for cmd 0x%04x\n", t, dir, packet[5],
+                    little_endian_read_16(packet, 3));
+                break;
+            }
+            if (packet[0] == 0x13 || packet[0] == 0x0e || packet[0] == 0x79 || packet[0] == 0x61) {
+                break;
+            }
+            if (packet[0] == HCI_EVENT_LE_META) {
+                if (packet[2] == 0x02 || packet[2] == 0x0d) {
+                    break;  // advertising reports
+                }
+                if ((packet[2] == 0x01 || packet[2] == 0x0a) && len >= 4) {
+                    // (Enhanced) Connection Complete: status, role (0 central, 1 peripheral)
+                    mp_printf(&mp_plat_print, "%u HCI %s LE CONNECTION COMPLETE status 0x%02x role %d\n", t, dir,
+                        packet[3], len >= 7 ? packet[6] : -1);
+                    break;
+                }
+                mp_printf(&mp_plat_print, "%u HCI %s LE meta 0x%02x\n", t, dir, packet[2]);
+            } else if (packet[0] == 0x05 && len >= 6) {
+                mp_printf(&mp_plat_print, "%u HCI %s DISCONNECT reason 0x%02x\n", t, dir, packet[5]);
+            } else if (packet[0] == 0x08 && len >= 6) {
+                mp_printf(&mp_plat_print, "%u HCI %s ENCRYPTION CHANGE status 0x%02x on %d\n", t, dir, packet[2], packet[5]);
+            } else {
+                mp_printf(&mp_plat_print, "%u HCI %s event 0x%02x\n", t, dir, packet[0]);
+            }
+            break;
+        case HCI_ACL_DATA_PACKET:
+            if (len >= 9) {
+                uint16_t cid = little_endian_read_16(packet, 6);
+                uint8_t op = packet[8];
+                if (cid == 0x0006) {
+                    if (op == 0x05 && len >= 10) {
+                        mp_printf(&mp_plat_print, "%u SMP %s PAIRING FAILED reason 0x%02x\n", t, dir, packet[9]);
+                    } else {
+                        mp_printf(&mp_plat_print, "%u SMP %s code 0x%02x\n", t, dir, op);
+                    }
+                } else if (cid == 0x0004) {
+                    if (op == 0x01 && len >= 13) {
+                        mp_printf(&mp_plat_print, "%u ATT %s ERROR req 0x%02x handle 0x%04x code 0x%02x\n", t, dir,
+                            packet[9], little_endian_read_16(packet, 10), packet[12]);
+                    } else if ((op == 0x0a || op == 0x12 || op == 0x52 || op == 0x1b || op == 0x1d) && len >= 11) {
+                        mp_printf(&mp_plat_print, "%u ATT %s op 0x%02x handle 0x%04x\n", t, dir, op, little_endian_read_16(packet, 9));
+                    } else {
+                        mp_printf(&mp_plat_print, "%u ATT %s op 0x%02x\n", t, dir, op);
+                    }
+                }
+            }
+            break;
+        default:
+            break;
+    }
+}
+
+static const hci_dump_t wattwind_trace_dump = {
+    &wattwind_trace_reset,
+    &wattwind_trace_log_packet,
+    &wattwind_trace_log_message,
+};
+#endif // WATTWIND_BT_TRACE
