+#if MICROPY_PY_BLUETOOTH_ENABLE_PAIRING_BONDING
+// WattWind (Bluetooth pairing, measured with a Garmin Edge 1040, 2026-11-03):
+// 1. BTstack sends Security Manager events only to SM handlers, and none was registered, so a "Just Works"
+//    pairing waited for an answer that never came. Approve it when bonding is on (ble.config(bond=True)),
+//    decline it otherwise, so the other side gets a clear "pairing not supported" instead of a stall.
+// 2. Bonds were kept in RAM only (le_device_db_memory, fixed placeholder ER/IR keys), so after a restart a
+//    bonded device asked for its key and got no answer. Now BTstack's TLV store is backed by the Python
+//    _IRQ_GET_SECRET / _IRQ_SET_SECRET events (as with NimBLE): the device database (le_device_db_tlv) and
+//    BTstack's own random ER/IR keys are kept by the program, e.g. in a file.
+// 3. The GAP service had no Appearance (mandatory; Garmin decides the sensor type from it): see
+//    BTSTACK_GAP_APPEARANCE_HANDLE, set with ble.gatts_write(5, struct.pack("<H", appearance)).
+
+#define WATTWIND_TLV_SECRET_TYPE (0x57)  // _IRQ_GET/SET_SECRET sec_type for BTstack TLV tags ('W')
+
+static void btstack_packet_handler_sm(uint8_t packet_type, uint16_t channel, uint8_t *packet, uint16_t size) {
+    if (packet_type != HCI_EVENT_PACKET) {
+        return;
+    }
+    uint8_t event_type = hci_event_packet_get_type(packet);
+    if (event_type == SM_EVENT_JUST_WORKS_REQUEST) {
+        hci_con_handle_t con_handle = sm_event_just_works_request_get_handle(packet);
+        if (mp_bluetooth_btstack_sm_auth_req & SM_AUTHREQ_BONDING) {
+            sm_just_works_confirm(con_handle);
+        } else {
+            sm_bonding_decline(con_handle);
+        }
+        #ifdef WATTWIND_BT_TRACE
+        mp_printf(&mp_plat_print, "sm: just works request, %s\n",
+            (mp_bluetooth_btstack_sm_auth_req & SM_AUTHREQ_BONDING) ? "approved" : "declined (bond off)");
+        #endif
+    } else if (event_type == SM_EVENT_PAIRING_COMPLETE) {
+        #ifdef WATTWIND_BT_TRACE
+        mp_printf(&mp_plat_print, "sm: pairing complete, status %d reason %d\n",
+            sm_event_pairing_complete_get_status(packet), sm_event_pairing_complete_get_reason(packet));
+        #endif
+        btstack_packet_handler_generic(packet_type, channel, packet, size);
+    } else {
+        #ifdef WATTWIND_BT_TRACE
+        mp_printf(&mp_plat_print, "sm: event 0x%02x\n", event_type);
+        #endif
+    }
+}
+
+static btstack_packet_callback_registration_t sm_event_callback_registration = {
+    .callback = &btstack_packet_handler_sm
+};
+
+static int wattwind_tlv_get_tag(void *context, uint32_t tag, uint8_t *buffer, uint32_t buffer_size) {
+    (void)context;
+    uint8_t key[4];
+    little_endian_store_32(key, 0, tag);
+    const uint8_t *value = NULL;
+    size_t value_len = 0;
+    if (!mp_bluetooth_gap_on_get_secret(WATTWIND_TLV_SECRET_TYPE, 0, key, sizeof(key), &value, &value_len)) {
+        return 0;
+    }
+    if (value_len != buffer_size) {
+        return 0;   // a stored value of another size (other build) counts as missing
+    }
+    memcpy(buffer, value, value_len);
+    return value_len;
+}
+
+static int wattwind_tlv_store_tag(void *context, uint32_t tag, const uint8_t *data, uint32_t data_size) {
+    (void)context;
+    uint8_t key[4];
+    little_endian_store_32(key, 0, tag);
+    return mp_bluetooth_gap_on_set_secret(WATTWIND_TLV_SECRET_TYPE, key, sizeof(key), data, data_size) ? 0 : 1;
+}
+
+static void wattwind_tlv_delete_tag(void *context, uint32_t tag) {
+    (void)context;
+    uint8_t key[4];
+    little_endian_store_32(key, 0, tag);
+    mp_bluetooth_gap_on_set_secret(WATTWIND_TLV_SECRET_TYPE, key, sizeof(key), NULL, 0);
+}
+
+static const btstack_tlv_t wattwind_tlv = {
+    &wattwind_tlv_get_tag,
+    &wattwind_tlv_store_tag,
+    &wattwind_tlv_delete_tag,
+};
