	(text "Plug polarity unknown: MAINS_A / MAINS_B, not L / N. K0 disconnects both conductors. PS1 is tapped before K0."
		(exclude_from_sim no)
		(at 63.5 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "57f30208-d793-420b-a078-764cd1509af5")
	)
	(text "RC snubbers across the fan windings (DNP). Fit only if fan speed changes cause resets or radio dropouts.\nAcross the load, never across relay contacts: X2 leakage (~7 mA) would bypass K0."
		(exclude_from_sim no)
		(at 264.16 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "66d46fb1-53aa-483a-b3fc-c72fc2032d17")
	)
	(text "Interlock chain: K0 -> K3 (HIGH) -> K2 (MED) -> K1 (LOW). Unused NC contacts are live: they carry MAINS_* nets, never no-connect."
		(exclude_from_sim no)
		(at 63.5 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6751d209-0443-4e15-a931-d93583648b68")
	)
	(text "LOW-VOLTAGE SIDE: GPIO assignments must match firmware/relay.py (source of truth). Relays active HIGH."
		(exclude_from_sim no)
		(at 63.5 144.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "7108118c-dacc-4bb0-8cef-c4a3e66d4556")
	)
	(text "U1 = TBD62003A (pin-compatible with ULN2003A symbol). COM (pin 9) to VSYS enables the flyback diodes."
		(exclude_from_sim no)
		(at 63.5 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9ae0b1a5-9e93-434a-9ec0-c1f4abd1a69c")
	)
	(text "Relay coils and U1 COM run from VSYS: relays also work on USB power alone (bench test without mains)."
		(exclude_from_sim no)
		(at 63.5 153.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c0abf57d-cf02-4c5f-b150-0d4e8dc83a28")
	)
	(text "MAINS SIDE (230 VAC): net class Mains, >= 8 mm clearance and creepage to LV"
		(exclude_from_sim no)
		(at 63.5 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
